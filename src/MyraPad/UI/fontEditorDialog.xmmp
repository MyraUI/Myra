<Project>
  <Project.ExportOptions Namespace="MyraPad.UI" Class="FontEditorDialog" OutputPath="D:\Projects\Myra\src\MyraPad\UI" FieldsVisibility="Private" />
  <Dialog Title="Font Editor" Left="552" Top="312">
    <VerticalStackPanel Spacing="8">
      <TextBox Readonly="True" Width="400" Id="_textValue" />
      <HorizontalStackPanel Spacing="8">
        <Label Text="Size" VerticalAlignment="Center" />
        <SpinButton Maximum="100" Minimum="4" Value="32" Integer="True" Width="50" Id="_spinSize" />
      </HorizontalStackPanel>
      <Button Id="_buttomSetFromStylesheet">
        <Label Text="Set Font From Stylesheet" />
      </Button>
      <Button Id="_buttonSetFromFile">
        <Label Text="Set Font From External File" />
      </Button>
    </VerticalStackPanel>
  </Dialog>
</Project>